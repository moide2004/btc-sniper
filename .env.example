# =====================================================================
# CRM Fournisseurs Airlaid — variables d'environnement
# Copiez ce fichier en « .env » et renseignez vos valeurs.
# .env est git-ignoré : il ne sera JAMAIS committé.
# =====================================================================

# --- PHASE 1 : CRM Google Sheets (Option A) --------------------------
# Chemin ABSOLU vers la clé JSON du service account (jamais son contenu).
GOOGLE_SERVICE_ACCOUNT_JSON=/chemin/absolu/vers/service_account.json
# URL de la feuille « CRM Fournisseurs Airlaid » partagée en Éditeur
# avec l'e-mail du service account.
GSHEET_URL=https://docs.google.com/spreadsheets/d/XXXXXXXXXXXX/edit

# --- PHASE 2/3 : boîte IONOS (lecture seule + brouillons) ------------
# À renseigner au moment de la Phase 2. AUCUN SMTP, JAMAIS d'envoi.
IMAP_HOST=imap.ionos.fr
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# Détecté automatiquement en Phase 2 (dossier avec l'attribut \Drafts).
IMAP_DRAFTS=

# --- Signature des brouillons (Phase 3) ------------------------------
SIGN_NAME=
SIGN_ROLE=
SIGN_COMPANY=ArcaneLogistics
SIGN_PHONE=

# --- Livraison des échantillons (Phase 3) ----------------------------
ADRESSE_ECHANTILLONS=
