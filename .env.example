# ===========================================================================
# Moteur de probabilités BTC — configuration (§7.8)
# Copier en .env et renseigner. NE JAMAIS committer .env ni de secret en dur.
# ===========================================================================

# --- Chemins (relatifs à la racine du projet par défaut) ---
MOTEUR_DB=data/moteur.db
OHLCV_DIR=data/ohlcv
LOG_DIR=logs
BACKUP_DIR=backups

# --- Instrument ---
SYMBOL=BTCUSDT
# Historique minimal à backfiller au premier démarrage (jours de 1m)
BACKFILL_DAYS=730

# --- Capital / coûts (§5.5, §5.8) — verdicts de coûts, pas d'edge ---
CAPITAL_USD=3000
FEE_TAKER=0.0010
FEE_MAKER=0.0003

# --- Cadences worker (secondes) ---
HEARTBEAT_SECONDS=30
# Seuil de bascule si source primaire muette (secondes, §7.4)
PRIMARY_SILENCE_SECONDS=300

# --- Sources de données (ordre de repli §2.3 / §7.4) ---
# primaire websocket + REST : binance ; replis REST : kraken, coinbase, coingecko
DATA_PRIMARY=binance
DATA_FALLBACKS=kraken,coinbase,coingecko

# --- Sécurité web app (§6.4) — hash obligatoire, aucun mot de passe en clair ---
# Générer :  python -c "from werkzeug.security import generate_password_hash as g; print(g('MON_MOT_DE_PASSE'))"
# (werkzeug est fourni par flask). À défaut, hash sha256 hex accepté (voir web/app.py).
WEB_PASSWORD_HASH=
# Clé de session Flask — générer :  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
