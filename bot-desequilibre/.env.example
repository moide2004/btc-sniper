# ===========================================================================
# Bot Déséquilibré — configuration (§4). Copier en .env, renseigner.
# NE JAMAIS committer .env ni de secret en dur.
# ===========================================================================

# --- Actifs analysés (dual-actif §1) ---
SYMBOLS=BTCUSDT,ETHUSDT

# --- Chemins (relatifs à la racine du projet par défaut) ---
MOTEUR_DB=data/moteur.db
OHLCV_DIR=data/ohlcv
LOG_DIR=logs
BACKUP_DIR=backups

# --- Profondeur d'historique 1m à backfiller au 1er démarrage (jours) ---
# Le 1m est la granularité de collecte/simulation ; l'analyse se fait ≥ 15m.
BACKFILL_DAYS=730

# --- Capital / coûts (§2.6, §3) — capital PARTAGÉ BTC+ETH (§5.4) ---
CAPITAL_USD=3000
FEE_TAKER=0.0010
FEE_MAKER=0.0003
RISK_PCT=0.015
SHORT_RISK_FACTOR=0.75

# --- Cadences worker (secondes) ---
HEARTBEAT_SECONDS=30
PRIMARY_SILENCE_SECONDS=300

# --- Sources de données (ordre de repli §4.2) ---
DATA_PRIMARY=binance
DATA_FALLBACKS=kraken,coinbase,coingecko

# --- Moteur §2 / probas §3 (P2) — défauts épinglés du BRIEF ; (†) = sans défaut
#     explicite au BRIEF, à confirmer (§9.1). L'analyse se fait sur ces TF, PAS
#     sur le 1m (substrat de collecte). ---
ANALYSIS_TIMEFRAMES=15m,30m,1h,4h,12h,1D
FIB_LOOKBACK=50
RR_MULT=1.5
RR_GRID=1.0,1.5,2.0
STOP_MAX_ATR=3.0
STOP_MIN_ATR=0.5
BUFFER_ATR=0.10
MIN_AMP_ATR=1.0
ATR_PERIOD=14
ACTIVER_SHORTS=1
SOLIDE_MIN_N=200
RISK_CAP_PCT=4.0
CORR_HIGH=0.8
BE_TRIGGER=1.0

# --- Sécurité web app (§6) — hash obligatoire, aucun mot de passe en clair ---
# Générer :  python -c "from werkzeug.security import generate_password_hash as g; print(g('MON_MDP'))"
WEB_PASSWORD_HASH=
# Clé de session Flask — python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- Push téléphone via ntfy (OPTIONNEL — amendement BRIEF 2026-07-25) ---
# 1) Installer l'appli « ntfy » (Android/iOS), s'abonner à un sujet SECRET.
# 2) Mettre ce même sujet ici. Vide = aucune notification envoyée.
# Le sujet fait office de mot de passe : long et imprévisible !
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh
